"""Authenticate graph-copy experiments and independently recompute every completion."""

from __future__ import annotations

import argparse
import copy
import json
from collections import Counter
from dataclasses import asdict
from pathlib import Path

import numpy as np
from rdkit import rdBase

from experiments.phase1.multireaction.combinatorial_generation_verify import (
    verify as verify_baseline,
)
from experiments.phase1.multireaction.combinatorial_graph_reuse import SCHEMA, compare, validate
from experiments.phase1.multireaction.combinatorial_reuse_pilot import _digest, assess_rows
from forge.assembly.families import load_assembly_libraries
from forge.core.hashing import resolve_pin, sha256_file
from forge.corpus.synthesis_program_production_cache import SynthesisProgramProductionCache
from forge.model.precursor_reuse import PrecursorReuseError, qualify_reuse
from forge.model.precursor_reuse_projection import (
    complete_reuse,
    fixed_graph_preserved,
    graph_smiles,
    state_graph,
)
from forge.model.synthesis_program_sampling import load_synthesis_program_checkpoint


def verify(repo: Path, result_path: Path, replay_path: Path | None = None) -> dict:
    repo = repo.resolve()
    result_path = (repo / result_path).resolve()
    result = json.loads(result_path.read_text())
    if (
        result.get("schema_version") != SCHEMA
        or result.get("status") != "numerical_complete"
        or result.get("model_promoted") is not False
        or result.get("training_calls") != 0
        or result.get("extra_neural_generation_calls") != 0
    ):
        raise PrecursorReuseError("invalid graph-copy schema/status/call contract")
    for pin in [
        result["config"],
        *result["sources"],
        *result["inputs"].values(),
        *result["artifacts"].values(),
        *result["registry_inputs"],
    ]:
        resolve_pin(pin, repo, label="graph-copy verification")
    config = json.loads((repo / result["config"]["path"]).read_text())
    validate(config)
    if config["inputs"] != result["inputs"]:
        raise PrecursorReuseError("configured graph-copy inputs substituted")
    paths = {k: repo / p["path"] for k, p in config["inputs"].items()}
    verify_baseline(repo, paths["baseline_result"])
    baseline = json.loads(paths["baseline_result"].read_text())
    if any(
        baseline["inputs"][k] != config["inputs"][k]
        for k in ("cache", "checkpoint", "dataset_config", "component_partitions")
    ):
        raise PrecursorReuseError("graph-copy inputs differ from frozen baseline")
    expected_sources = {p["path"] for p in baseline["sources"]} | {
        "forge/model/precursor_reuse.py",
        "forge/model/precursor_reuse_projection.py",
        "forge/model/defog_feasibility.py",
        "forge/model/sparse_topology_feasibility.py",
        "experiments/phase1/multireaction/combinatorial_reuse_pilot.py",
        "experiments/phase1/multireaction/combinatorial_graph_reuse.py",
    }
    if {p["path"] for p in result["sources"]} != expected_sources:
        raise PrecursorReuseError("graph-copy source manifest incomplete")
    dataset = json.loads(paths["dataset_config"].read_text())
    registries = [dataset["inputs"][k] for k in dataset["registries"]]
    if result["registry_inputs"] != registries:
        raise PrecursorReuseError("registry inputs substituted")
    libraries = load_assembly_libraries(
        [(repo / p["path"], p["sha256"]) for p in registries],
        expected_families=dataset["programs"],
    )
    families = sorted(libraries)

    def read(name: str):
        text = (repo / result["artifacts"][name]["path"]).read_text()
        return (
            [json.loads(s) for s in text.splitlines()]
            if name.endswith("jsonl")
            else json.loads(text)
        )

    layouts = read("layouts.json")
    rows, terminals, completions = map(
        read, ("attempts.jsonl", "terminals.jsonl", "completions.jsonl")
    )
    plans = read("reuse_plans.json")
    count = len(layouts)
    if (
        count != len(families) * config["sampling"]["attempts_per_family"]
        or any(len(v) != count for v in (terminals, completions, plans))
        or Counter((r["arm"], r["sample_index"]) for r in rows)
        != Counter((a, i) for a in ("baseline", "graph_reuse") for i in range(count))
        or result["sampler"]["fixed_state_failures"]
    ):
        raise PrecursorReuseError("graph-copy attempt accounting mismatch")
    indices = [r["index"] for r in layouts]
    with SynthesisProgramProductionCache(paths["cache"]) as cache, rdBase.BlockLogs():
        if any(cache.fold(i) != "train" for i in indices):
            raise PrecursorReuseError("nontraining graph-copy layout used")
        if config["use_saved_layouts"]:
            expected_layouts = json.loads(
                (repo / baseline["artifacts"]["layouts.json"]["path"]).read_text()
            )
            base_config = json.loads((repo / baseline["config"]["path"]).read_text())
            if config["sampling"] != {
                "layout_seed": base_config["seed"],
                **base_config["sampling"],
            }:
                raise PrecursorReuseError("frozen baseline sampling changed")
        else:
            rng = np.random.default_rng(config["sampling"]["layout_seed"])
            measure = cache.training_measure({f: 1 / len(families) for f in families})
            selected = []
            for family in families:
                choices = cache.indices(program_id=family, fold="train")
                selected.extend(
                    int(i)
                    for i in rng.choice(
                        choices,
                        size=config["sampling"]["attempts_per_family"],
                        p=measure[choices] / measure[choices].sum(),
                    )
                )
            expected_layouts = [
                {
                    "index": i,
                    "record_id": cache.record_id(i),
                    "family": cache.program_id(i),
                    "depth": cache.record(i).program_depth,
                    "nodes": cache.record(i).node_count,
                    "fold": "train",
                }
                for i in selected
            ]
        if layouts != expected_layouts:
            raise PrecursorReuseError("seeded TRAIN layout stream changed")
        records = cache.records(indices)
        expected_plans = [
            qualify_reuse(
                r, libraries[r.program_id], dataset["programs"][r.program_id], dataset["limits"]
            )
            for r in records
        ]
        if _digest(plans) != _digest([asdict(p) for p in expected_plans]):
            raise PrecursorReuseError("reuse correspondence qualification changed")
        train = {cache.canonical_smiles(int(i)) for i in cache.indices(fold="train")}
    components = {
        r["constitution_id"]
        for r in json.loads(paths["component_partitions"].read_text())
        if r["fold"] == "train"
    }
    arms = {a: [r for r in rows if r["arm"] == a] for a in ("baseline", "graph_reuse")}
    for arm, local in arms.items():
        if [r["sample_index"] for r in local] != list(range(count)) or any(
            r["layout_record_id"] != layout["record_id"] or r["program_id"] != layout["family"]
            for r, layout in zip(local, layouts, strict=True)
        ):
            raise PrecursorReuseError("attempt layout/order mismatch")
        with rdBase.BlockLogs():
            expected = assess_rows(local, records, arm, dataset, libraries, train, components)
        if _digest(local) != _digest(expected):
            raise PrecursorReuseError("graph-copy scoring differs from recomputation")
    _, _, atoms, *_ = load_synthesis_program_checkpoint(paths["checkpoint"], device="cpu")
    with rdBase.BlockLogs():
        for i, (record, plan, terminal, original) in enumerate(
            zip(records, expected_plans, terminals, arms["baseline"], strict=True)
        ):
            if terminal["state"] is None:
                if original["valid_connected"]:
                    raise PrecursorReuseError("valid original has no terminal graph")
            else:
                nodes, edges = state_graph(terminal["state"])
                if graph_smiles(nodes, edges, atoms) != original[
                    "canonical_smiles"
                ] or not fixed_graph_preserved(nodes, edges, record):
                    raise PrecursorReuseError("terminal differs from original/fixed graph")
            completed = complete_reuse(
                record=record,
                plan=plan,
                terminal=terminal,
                original=original,
                atoms=atoms,
                adapter=libraries[record.program_id],
                policy=dataset["programs"][record.program_id],
                limits=dataset["limits"],
            )
            if _digest(completed) != _digest(completions[i]):
                raise PrecursorReuseError("completion/proposal ledger differs from recomputation")
            if arms["graph_reuse"][i]["canonical_smiles"] != completed["selected_smiles"]:
                raise PrecursorReuseError("selected completion differs from scored graph")
    expected = {
        **compare(rows, families),
        "reuse_qualification": dict(Counter(p.status for p in expected_plans)),
        "completion_dispositions": dict(Counter(c["disposition"] for c in completions)),
        "proposal_dispositions": dict(
            Counter(p["status"] for c in completions for p in c["proposals"])
        ),
        "additional_assembly_checks": sum(c["additional_assembly_checks"] for c in completions),
        "graph_copy_proposals": sum(len(c["proposals"]) for c in completions),
        "reference_train_products": len(train),
        "reference_train_components": len(components),
        "frozen_generation_reproduced": config["use_saved_layouts"],
    }
    if any(result[k] != value for k, value in expected.items()):
        raise PrecursorReuseError("summary/decision differs from attempts")
    if config["use_saved_layouts"]:
        original = [
            json.loads(s)
            for s in (repo / baseline["artifacts"]["attempts.jsonl"]["path"])
            .read_text()
            .splitlines()
        ]
        if _digest([r for r in original if r["arm"] == "trained"]) != _digest(
            [{**r, "arm": "trained"} for r in arms["baseline"]]
        ):
            raise PrecursorReuseError("frozen original outputs changed")
    replay_equal = None
    if replay_path is not None:
        verify(repo, replay_path)
        replay = json.loads((repo / replay_path).read_text())

        def stable(value: dict) -> dict:
            value = copy.deepcopy(value)
            value["artifact_hashes"] = {k: p["sha256"] for k, p in value["artifacts"].items()}
            for key in ("created_at_utc", "duration_seconds", "artifacts"):
                value.pop(key)
            return value

        replay_equal = stable(result) == stable(replay)
        if not replay_equal:
            raise PrecursorReuseError("graph-copy scientific payload replay differs")
    return {
        "status": "verified",
        "result_sha256": str(sha256_file(result_path)),
        "attempts_recomputed": len(rows),
        "completions_recomputed": count,
        "replay_identical": replay_equal,
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo-root", type=Path, default=Path("."))
    parser.add_argument("--result", type=Path, required=True)
    parser.add_argument("--replay", type=Path)
    args = parser.parse_args()
    print(json.dumps(verify(args.repo_root, args.result, args.replay), indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
