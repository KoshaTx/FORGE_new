{"files": [{"id": 37939010, "name": "nn2c07822_si_001.pdf", "size": 1767958, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/37939010", "supplied_md5": "215652c3e481c4b1bf097ed416d633ac", "computed_md5": "215652c3e481c4b1bf097ed416d633ac", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 85501, "full_name": "Zhongyu Li", "first_name": "Zhongyu", "last_name": "Li", "is_active": false, "url_name": "Zhongyu_Li", "orcid_id": ""}, {"id": 1273854, "full_name": "Xue-Qing Zhang", "first_name": "Xue-Qing", "last_name": "Zhang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2139412, "full_name": "William Ho", "first_name": "William", "last_name": "Ho", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 5870084, "full_name": "Fengqiao Li", "first_name": "Fengqiao", "last_name": "Li", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 7489772, "full_name": "Mingzhu Gao", "first_name": "Mingzhu", "last_name": "Gao", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1933264, "full_name": "Xin Bai", "first_name": "Xin", "last_name": "Bai", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1865383, "full_name": "Xiaoyang Xu", "first_name": "Xiaoyang", "last_name": "Xu", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Enzyme-Catalyzed_One-Step_Synthesis_of_Ionizable_Cationic_Lipids_for_Lipid_Nanoparticle-Based_mRNA_COVID-19_Vaccines/21379289", "download_disabled": false, "description": "Ionizable cationic lipid-containing\nlipid nanoparticles (LNPs)\nare the most clinically advanced non-viral gene delivery platforms,\nholding great potential for gene therapeutics. This is exemplified\nby the two COVID-19 vaccines employing mRNA-LNP technology from Pfizer/BioNTech\nand Moderna. Herein, we develop a chemical library of ionizable cationic\nlipids through a one-step chemical-biological enzyme-catalyzed esterification\nmethod, and the synthesized ionizable lipids were further prepared\nto be LNPs for mRNA delivery. Through orthogonal design of experiment\nmethodology screening, the top-performing AA3-DLin LNPs show outstanding\nmRNA delivery efficacy and long-term storage capability. Furthermore,\nthe AA3-DLin LNP COVID-19 vaccines encapsulating SARS-CoV-2 spike\nmRNAs successfully induced strong immunogenicity in a BALB/c mouse\nmodel demonstrated by the antibody titers, virus challenge, and T\ncell immune response studies. The developed AA3-DLin LNPs are an excellent\nmRNA delivery platform, and this study provides an overall perspective\nof the ionizable cationic lipids, from aspects of lipid design, synthesis,\nscreening, optimization, fabrication, characterization, and application.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1767958, "created_date": "2022-10-21T14:06:30Z", "modified_date": "2023-07-01T21:29:06Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["term storage capability", "synthesized ionizable lipids", "ionizable cationic lipids", "holding great potential", "clinically advanced non", "catalyzed esterification method", "containing lipid nanoparticles", "based mrna covid", "experiment methodology screening", "dlin lnp covid", "two covid", "mrna delivery", "lnp technology", "lipid nanoparticle", "lipid design", "virus challenge", "study provides", "step chemical", "overall perspective", "orthogonal design", "gene therapeutics", "dlin lnps", "chemical library", "catalyzed one", "antibody titers"], "keywords": ["term storage capability", "synthesized ionizable lipids", "ionizable cationic lipids", "holding great potential", "clinically advanced non", "catalyzed esterification method", "containing