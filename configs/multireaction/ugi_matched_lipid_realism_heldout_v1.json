{
  "schema_version": "forge.ugi_matched_lipid_realism_config.v1",
  "scientific_question": "Per requested Ugi generation attempt, does the frozen method produce diverse complete graphs near source-adjudicated measured held-out Ugi lipids?",
  "inputs": {
