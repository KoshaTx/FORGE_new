{
  "schema_version": "forge.synthesis_program_training_config.v1",
  "seed": 20260830,
  "inputs": {},
  "model": {
    "architecture": "reaction_program_graph_transformer",
    "hidden_dim": 64,
    "layers": 3,
    "attention_heads": 4,
    "expert_count": 3,
    "adapter_dim": 16,
    "dropout": 0.0,
    "bond_classes": 4,
    "maximum_heavy_atoms": 194,
    "maximum_closures": 3,
    "semantic_objective": {
      "role_consistency_weight": 0.25,
      "core_consistency_weight": 0.25,
      "state_balancing": "equal_present_semantic_state_mass"
    },
    "gradient_balancing": {
      "method": "per_family_norm_balanced_deterministic_pcgrad",
      "group_identity": "source_program_state"
