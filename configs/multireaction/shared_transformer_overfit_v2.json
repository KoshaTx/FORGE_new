  "training": {
    "steps": 2400,
    "batch_size": 3,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "gradient_clip_norm": 1.0
  },
  "evaluation": {
    "corruption_time": 0.5
  },
  "execution": {
    "device": "cpu",
    "precision": "float32",
    "cpu_threads": 2,
    "checkpoint_interval_steps": 400,
    "deterministic_algorithms": true
  },
  "gates": {
    "maximum_final_to_initial_loss_ratio": 0.5,
    "minimum_exact_tensor_records": 3
  },
  "claim_boundary": "Bounded three-record positional-memory Transformer overfit gate only; no generalization or production-training claim. The 2,400-step budget is a new follow-up after the 1,200-step positional-memory gate missed one Ugi parent pointer; no acceptance threshold changed."
}
